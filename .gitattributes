# Windows/Linux 换行符规范
# shell scripts MUST use LF line endings
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
# Dockerfile uses LF
Dockerfile* text eol=lf
# bat files use CRLF
*.bat text eol=crlf
