# 后端 .env 模板 (复制为 .env 后修改)
# 所有变量也可通过 export 命令直接设置

# App
APP_NAME="Smart Scenic Backend API"
APP_VERSION="2.0.0"
DEBUG=false
CORS_ORIGINS=["*"]

# MySQL (默认端口 3306, P0 已重置 schema)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=root123
MYSQL_DB=scenic

# HiveServer2
HIVE_HOST=hive-server-1
HIVE_PORT=10000
HIVE_DB=scenic_dw

# HBase Stargate REST
HBASE_REST_URL=http://hbase-master:8085

# HDFS WebHDFS
HDFS_NAMENODE=hadoop-namenode
HDFS_PORT=9870
HDFS_USER=root

# ML 模型路径 (P1 写到 HDFS)
HDFS_MODEL_BASE=/scenic/ml/models
HDFS_ML_PRED=/scenic/ml/predictions

# 容错
ENABLE_MOCK_FALLBACK=true
