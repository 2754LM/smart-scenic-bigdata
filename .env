# ====== 智能景区大数据平台 - 环境变量 ======
# 组件版本严格对齐 docx 原始方案 (Ubuntu 16.04 + JDK 1.8.0_162)
# 见 docs/REFERENCE.md 与 AGENTS.md

NETWORK_NAME=bigdata-net

# ---------- 基础镜像 / OS ----------
# Ubuntu 16.04 (原始方案基线)
OS_VERSION=ubuntu-16.04
# JDK 1.8.0_162 (jdk-8u162-linux-x64.tar.gz)
JDK_VERSION=1.8.0_162
# Maven 3.8.5 (apache-maven-3.8.5-bin.tar.gz)
MAVEN_VERSION=3.8.5

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=scenic
MYSQL_USER=scenic
MYSQL_PASSWORD=scenic123

# ---------- 镜像版本（全部用 Docker 官方 / Apache 官方） ----------
# 注：版本号必须与 docx 原始方案一致
ZK_VERSION=3.6.3
HADOOP_VERSION=3.1.0
HIVE_VERSION=3.1.3
HBASE_VERSION=2.4.11
KAFKA_VERSION=3.1.0
SPARK_VERSION=3.1.0

# ---------- Hive ----------
HIVE_METASTORE_DB_HOST=mysql
HIVE_METASTORE_DB_PORT=3306

# ---------- HBase ----------
HBASE_MASTER=hbase-master
HBASE_REGIONSERVERS=hbase-regionserver-1 hbase-regionserver-2

# ---------- Kafka ----------
# Kafka 3.1.0 对应 Scala 2.12 版 (kafka_2.12-3.1.0.tgz)
KAFKA_SCALA_VERSION=2.12
KAFKA_BROKERS=kafka-1:9092,kafka-2:9092
KAFKA_NODE_ID_1=1
KAFKA_NODE_ID_2=2

# ---------- Spark ----------
SPARK_MASTER=spark-master
SPARK_WORKERS=spark-worker-1

# ============================================================
# 端口映射（全部用冷门端口 1xxxx，避免与 Windows 常见服务冲突）
# ============================================================

PORT_MYSQL=13306

PORT_ZK=12181
PORT_ZK_FOLLOWER=12888
PORT_ZK_ELECTION=13888

PORT_HADOOP_NN_RPC=19000
PORT_NAMENODE_WEB=19870
PORT_YARN_WEB=18088
PORT_YARN_JHS_RPC=11020
PORT_YARN_JHS_WEB=11988

PORT_HBASE_MASTER_RPC=11600
PORT_HBASE_WEB=11610
PORT_HBASE_RS_RPC=11620
PORT_HBASE_RS_WEB=11630
# HBase Thrift (19090) and REST (19086) ports removed - backend uses docker exec
# (see AGENTS.md 5.3 for why)

PORT_SPARK_RPC=17077
PORT_SPARK_WEB=18080

PORT_KAFKA=19092
PORT_KAFKA_EXTERNAL=19095
PORT_KAFKA_CONTROLLER=19093

PORT_HIVE=11010
PORT_HIVE_WEB=11012
PORT_HIVE_2=11011
PORT_HIVE_2_WEB=11013
